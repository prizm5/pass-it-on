# Pass It On public site.
#
# Expects the stack to be running locally on:
# - web:   http://localhost:5173
# - api:   http://localhost:5200
#
# Set these in .env before building the containers:
# - WEB_PUBLIC_URL=https://passiton.nilscreque.com
# - WEB_VITE_API_URL=/api
# - ADMIN_PUBLIC_URL=https://admin.passiton.nilscreque.com
# - ADMIN_VITE_API_URL=/api
#
# The admin SPA currently assumes it is mounted at /, so do not proxy it under
# /admin on the same host without changing the app's Vite base/path handling.
server {
  server_name passiton.nilscreque.com;

  client_max_body_size 10m;

  location /api/ {
    proxy_pass http://localhost:5200/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
  }

  location = /health {
    proxy_pass http://localhost:5200/health;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
  }

  location ^~ /swagger/ {
    proxy_pass http://localhost:5200;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
  }

  location / {
    proxy_pass http://localhost:5173;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
  }

  listen 443 ssl; # managed by Certbot
  ssl_certificate /etc/letsencrypt/live/passiton.nilscreque.com/fullchain.pem; # managed by Certbot
  ssl_certificate_key /etc/letsencrypt/live/passiton.nilscreque.com/privkey.pem; # managed by Certbot
  include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
  if ($host = passiton.nilscreque.com) {
    return 301 https://$host$request_uri;
  } # managed by Certbot

  listen 80;
  server_name passiton.nilscreque.com;
  return 404; # managed by Certbot
}

